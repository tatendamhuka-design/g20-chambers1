<file path="src/app/components/WhatsAppButton.js">
'use client'

import { useState, useEffect } from 'react'

export default function WhatsAppButton({ phoneNumber = '+27823413333' }) {
  const [isVisible, setIsVisible] = useState(false)

  useEffect(() => {
    const handleScroll = () => {
      if (window.scrollY > 300) {
        setIsVisible(true)
      } else {
        setIsVisible(false)
      }
    }

    window.addEventListener('scroll', handleScroll)
    return () => window.removeEventListener('scroll', handleScroll)
  }, [])

  const handleClick = () => {
    const cleanNumber = phoneNumber.replace(/[^0-9]/g, '')
    const whatsappUrl = `https://wa.me/${cleanNumber}?text=Hello%20G20%20Chambers%2C%20I%27d%20like%20to%20enquire%20about%20your%20services.`
    window.open(whatsappUrl, '_blank')
  }

  return (
    <div
      className={`fixed bottom-6 right-6 z-50 transition-all duration-500 transform ${
        isVisible ? 'translate-y-0 opacity-100' : 'translate-y-20 opacity-0'
      }`}
    >
      <button
        onClick={handleClick}
        className="relative group flex items-center justify-center w-14 h-14 bg-[#25D366] rounded-full shadow-2xl hover:shadow-[0_8px_32px_rgba(37,211,102,0.4)] transition-all duration-300 hover:scale-110"
        aria-label="Contact us on WhatsApp"
      >
        {/* Pulse Ring Animation */}
        <span className="absolute inset-0 rounded-full bg-[#25D366] animate-ping opacity-75"></span>
        <span className="absolute inset-0 rounded-full bg-[#25D366] animate-pulse opacity-50"></span>
        
        {/* Official WhatsApp SVG Icon */}
        <svg 
          className="w-7 h-7 text-white fill-current relative z-10"
          viewBox="0 0 24 24" 
