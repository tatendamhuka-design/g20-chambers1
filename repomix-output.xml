                  setSearchTerm('')
                }}
                className="mt-4 text-[#c9a84c] font-semibold hover:underline"
              >
                Clear filters
              </button>
            </div>
          )}
        </div>
      </section>

      <Footer />

      {selectedBarrister && (
        <QuickViewModal
